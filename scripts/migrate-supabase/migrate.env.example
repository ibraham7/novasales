# انسخ هذا الملف إلى migrate.env واملأ القيم (بدون علامات اقتباس، وبدون مسافات حول =).
# migrate.env فيه أسرار: لا ترفعه إلى git ولا ترسله لأحد (chmod 600).
#
# روابط قاعدة البيانات: من لوحة Supabase > زر Connect > Session pooler (يدعم IPv4).
# إذا كانت كلمة السر فيها رموز خاصة (@ : / ? # %) لازم تُشفَّر (URL-encode)، أو اختر كلمة سر بحروف وأرقام فقط.
OLD_DB_URL=postgresql://postgres.OLDREF:OLDPASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
NEW_DB_URL=postgresql://postgres.NEWREF:NEWPASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# لنقل الملفات (Storage): Project Settings > API
OLD_SUPABASE_URL=https://OLDREF.supabase.co
OLD_SERVICE_KEY=service_role_key_of_old_project
NEW_SUPABASE_URL=https://NEWREF.supabase.co
NEW_SERVICE_KEY=service_role_key_of_new_project
